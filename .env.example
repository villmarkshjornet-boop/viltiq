# Kopier denne filen til .env (eller .env.local) og fyll inn dine egne verdier.
# .env/.env.local er gitignored — .env.example er malen som er sjekket inn.
#
# Alle EXPO_PUBLIC_-variabler blir inlinet i JS-bunten ved bygg (web, iOS, Android).
# Dette er IKKE hemmeligheter — Firebase sin klient-konfigurasjon er ment å være
# offentlig; selve sikkerheten ligger i Firebase Auth + Firestore-reglene
# (se firestore.rules), ikke i å skjule disse verdiene.
#
# Mangler denne filen helt, faller appen tilbake til det eksisterende
# "viltiq"-Firebase-prosjektets verdier (se src/config/firebase.ts) — så dette
# er valgfritt inntil du faktisk vil peke mot et annet Firebase-prosjekt
# (f.eks. et eget dev/test-prosjekt, se docs/DEPLOYMENT.md).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Kreves for at kartet (react-native-maps med PROVIDER_GOOGLE) skal vise noe
# som helst på en ekte iOS/Android-enhet (Expo Go har en delt nøkkel, egne
# development/preview/production-builder har det ikke). Hentes fra Google
# Cloud Console — se docs/DEPLOYMENT.md. IKKE EXPO_PUBLIC_-prefikset: disse
# leses kun av app.config.js under bygg (native), ikke av selve app-koden,
# og trenger derfor ikke være tilgjengelig i den ferdige JS-bunten.
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=
