rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Hjelpefunksjoner ────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // Sjekk om den innloggede brukeren er medlem av et jaktlag
    function isMember(jaktlagId) {
      return isAuth() && exists(
        /databases/$(database)/documents/jaktlag/$(jaktlagId)/members/$(request.auth.uid)
      );
    }

    // ── Observasjoner ────────────────────────────────────────────────────────
    // Leses av: eier, alle (hvis observasjonen er offentlig, jaktlagId == ""),
    // eller medlemmer av jaktlaget observasjonen tilhører.
    match /observations/{id} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.jaktlagId == "" ||
        isMember(resource.data.jaktlagId)
      );
      // Kameraobservasjoner må arve nøyaktig samme jaktlagId som kameraet de
      // er koblet til (hindrer at en kameraobservasjon "hvitvaskes" til et
      // annet jaktlag enn kameraet faktisk tilhører). Manuelle observasjoner
      // (cameraId == null) må ha jaktlagId == "" (offentlig) eller brukeren
      // må faktisk være medlem av laget den påstår å tilhøre — uten dette
      // kunne en hvilken som helst innlogget bruker plantet falske
      // observasjoner i et vilkårlig jaktlags feed.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid && (
        request.resource.data.cameraId == null
          ? (request.resource.data.jaktlagId == "" || isMember(request.resource.data.jaktlagId))
          : get(/databases/$(database)/documents/cameras/$(request.resource.data.cameraId)).data.jaktlagId
              == request.resource.data.jaktlagId
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── Viltkameraer ────────────────────────────────────────────────────────
    // Eieren kan alltid lese/endre/slette. Jaktlag-medlemmer kan lese og
    // oppdatere (registrere sjekk/observasjon) et kamera som tilhører laget,
    // men kan ikke slette et kamera de ikke selv eier.
    match /cameras/{id} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.jaktlagId != null && resource.data.jaktlagId != "" && isMember(resource.data.jaktlagId))
      );
      // Må enten være et offentlig kamera (jaktlagId == "") eller opprettes
      // av et faktisk medlem av laget det tilordnes — ellers kunne enhver
      // innlogget bruker registrert et kamera "på" et vilkårlig jaktlag.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid && (
        request.resource.data.jaktlagId == "" || isMember(request.resource.data.jaktlagId)
      );
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.jaktlagId != null && resource.data.jaktlagId != "" && isMember(resource.data.jaktlagId))
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── Kartpunkter ("Annet": saltstein, fôringsplass, post, åte osv.) ───────
    // Samme synlighetsmodell som observasjoner.
    match /mapPoints/{id} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.jaktlagId == "" ||
        isMember(resource.data.jaktlagId)
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid && (
        request.resource.data.jaktlagId == "" || isMember(request.resource.data.jaktlagId)
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── Felling ─────────────────────────────────────────────────────────────
    // Eier kan alltid lese. Jaktlag-medlemmer kan lese jaktlagets fellinger.
    match /fellings/{id} {
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid ||
        (resource.data.jaktlagId != null && isMember(resource.data.jaktlagId))
      );
      // jaktlagId skrives nå alltid som "" (offentlig) eller et ekte lag-id
      // (aldri utelatt — se lagreFelling i felling.ts), så samme mønster som
      // observations/cameras/mapPoints kan brukes her også.
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid && (
        request.resource.data.jaktlagId == "" || isMember(request.resource.data.jaktlagId)
      );
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── Jaktlag ─────────────────────────────────────────────────────────────
    // Alle innloggede kan lese (nødvendig for å finne lag via invitasjonskode).
    // Kun lederen kan endre jaktlaget.
    match /jaktlag/{jaktlagId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.lederUid == request.auth.uid;
      allow update: if isAuth() && resource.data.lederUid == request.auth.uid;
      allow delete: if isAuth() && resource.data.lederUid == request.auth.uid;

      // Medlemmer
      match /members/{uid} {
        allow read:   if isMember(jaktlagId);
        // KRITISK: tidligere sjekket denne KUN at brukeren skrev sin egen
        // uid — uten noen verifisering av invitasjonskode. Det betydde at
        // enhver innlogget bruker kunne bli "medlem" av et hvilket som
        // helst jaktlag (og dermed lese lagets private observasjoner,
        // kameraer, fellinger og andre medlemmers sanntids-GPS-posisjon)
        // uten noensinne å ha fått invitasjonskoden. Nå kreves enten at
        // brukeren er lagets leder som registrerer seg selv rett etter
        // opprettelse (bevist via get() mot lederUid — se opprettJaktlag i
        // jaktlag.ts), eller at brukeren oppgir en invitKode i selve
        // skrivingen som matcher lagets faktiske kode (bevist server-side
        // via get(), ikke bare klientens egen sjekk — se bliMedIJaktlag).
        allow create: if isAuth() && uid == request.auth.uid && (
          get(/databases/$(database)/documents/jaktlag/$(jaktlagId)).data.lederUid == request.auth.uid ||
          (
            request.resource.data.rolle == "jeger" &&
            request.resource.data.invitKode
              == get(/databases/$(database)/documents/jaktlag/$(jaktlagId)).data.invitKode
          )
        );
        allow delete: if isAuth() && (
          uid == request.auth.uid ||
          get(/databases/$(database)/documents/jaktlag/$(jaktlagId)).data.lederUid == request.auth.uid
        );
        allow update: if false;
      }

      // Kvoter — kun jaktlag-medlemmer
      match /kvoter/{docId} {
        allow read, write: if isMember(jaktlagId);
      }
    }

    // ── Brukerposisjoner ────────────────────────────────────────────────────
    // Brukeren skriver kun sin egen posisjon.
    // Lesing: eget dokument, eller jaktlag-kollega (jaktlagId-felt matcher og brukeren er medlem).
    match /user_locations/{uid} {
      allow write: if isAuth() && uid == request.auth.uid;
      allow read:  if isAuth() && (
        uid == request.auth.uid ||
        (resource.data.jaktlagId != null && isMember(resource.data.jaktlagId))
      );
    }

    // ── Push-innstillinger ──────────────────────────────────────────────────
    // Kun eieren leser og skriver.
    match /users/{uid}/{document=**} {
      allow read, write: if isAuth() && uid == request.auth.uid;
    }
  }
}
